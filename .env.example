# Copy this file to .env and fill in your own key. Never commit .env itself.
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows)

# Your OpenAI API key, from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional. Defaults to gpt-5-mini if left blank.
OPENAI_MODEL=gpt-5-mini

# Optional. Set to 1 to log each agent run to Weights & Biases.
# Requires `pip install wandb` and `wandb login` first.
WANDB_ENABLED=0
WANDB_PROJECT=campuscourier
# Leave blank to log under your own account. Set it to a team name to log there instead.
WANDB_ENTITY=
